<Window x:Class="TextReader.LoadOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Load Text" Height="280" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left side: Radio buttons -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Load from:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <RadioButton x:Name="RandomTextRadio" Content="Random Text" IsChecked="True" Margin="0,5" Checked="RadioButton_Checked"/>
                    <RadioButton x:Name="FileRadio" Content="File" Margin="0,5" Checked="RadioButton_Checked"/>
                    <RadioButton x:Name="WebRadio" Content="Web" Margin="0,5" Checked="RadioButton_Checked"/>
                </StackPanel>
            </Border>

            <!-- Right side: Details for selected option -->
            <Grid Grid.Column="1" Margin="15,10,10,10">
                <!-- Random Text Panel -->
                <StackPanel x:Name="RandomTextPanel" Visibility="Visible">
                    <TextBlock Text="Random Text" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                    <TextBlock Text="Number of sentences:" Margin="0,0,0,5"/>
                    <TextBox x:Name="RandomTextSizeInput" Text="100" Margin="0,0,0,20"/>
                    <Button Content="Load Random Text" Click="LoadRandomText_Click" Padding="8,5" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- File Panel -->
                <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                    <TextBlock Text="From File" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                    <TextBlock Text="Select a file to load:" Margin="0,0,0,10"/>
                    <Button Content="Browse..." Click="LoadFromFile_Click" Padding="8,5" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Web Panel -->
                <StackPanel x:Name="WebPanel" Visibility="Collapsed">
                    <TextBlock Text="From Web" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                    <TextBlock Text="URL:" Margin="0,0,0,5"/>
                    <TextBox x:Name="WebUrlInput" Margin="0,0,0,20"/>
                    <Button Content="Load from Web" Click="LoadFromWeb_Click" Padding="8,5" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Width="80" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>
