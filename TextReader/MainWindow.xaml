<Window x:Class="TextReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextReader"
        mc:Ignorable="d"
        Title="Text Reader" Height="450" Width="800">

    <Grid>
        <DockPanel>

            <!-- Top toolbar -->
            <ToolBar DockPanel.Dock="Top">

                <Button Content="Load"
                        Click="LoadButton_Click"/>

                <Button Content="Save"
                        Click="SaveButton_Click" />

                <Separator/>

                <Button Content="Search"
                        Click="SearchButton_Click" />

            </ToolBar>

            <local:TextReaderControl x:Name="Reader"/>

        </DockPanel>

        <!-- Error Notification Popup -->
        <Border x:Name="ErrorNotification"
                Background="#D32F2F"
                CornerRadius="4"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,40"
                Visibility="Collapsed"
                MaxWidth="600">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠"
                           Foreground="White"
                           FontSize="16"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ErrorNotificationText"
                           Text="An error occurred"
                           Foreground="White"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>
