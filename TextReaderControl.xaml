<UserControl x:Class="TextReader.TextReaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TextReader"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" x:Name="SearchBar" Visibility="Visible" Background="#F0F0F0" BorderBrush="#CFCFCF" BorderThickness="0,0,0,1" Padding="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="SearchTextBox" MinWidth="200" VerticalAlignment="Center"/>
                <Button x:Name="SearchButton" Content="Search" Margin="5,0,0,0" Padding="10,2" Click="SearchButton_OnClick"/>
                <Button x:Name="SearchUpButton" Content="↑" Width="25" Margin="5,0,0,0"/>
                <Button x:Name="SearchDownButton" Content="↓" Width="25" Margin="5,0,0,0"/>
                <Button x:Name="SearchCloseButton" Content="✕" Width="25" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Reader -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#CFCFCF"
                    BorderThickness="1"
                    ClipToBounds="True">
                <local:RenderCanvas x:Name="TextReaderCanvas"
                        Focusable="True"
                        Background="White"/>
            </Border>

            <!-- Scrollbar -->
            <ScrollBar Grid.Column="1"
                       x:Name="ScrollBar"
                       Orientation="Vertical"
                       Minimum="0"
                       SmallChange="1"
                       LargeChange="20"
                       Scroll="Scroll_OnScroll"/>

        </Grid>

    </Grid>
</UserControl>
